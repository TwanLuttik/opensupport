{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensupport",
  // Cloudflare Workers Builds run `wrangler deploy` after the build command.
  // Do not also list wrangler as a dependency: its native runtime fails this install.
  "compatibility_date": "2026-10-08",
  // Static site only. The support server stays on Railway.
  "assets": {
    "directory": "./packages/site/dist",
    "not_found_handling": "404-page"
  }
}
